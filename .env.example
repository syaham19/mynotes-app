# ===========================================
# Contoh konfigurasi environment
# Salin file ini menjadi .env dan isi dengan nilai milik kamu
# ===========================================

# Port server aplikasi
APP_PORT=8080

# URL koneksi ke database PostgreSQL
# Format: postgres://username:password@host:port/nama_database?sslmode=disable
DATABASE_URL=postgres://username:password@localhost:5432/personal_notes?sslmode=disable

# Secret key untuk menandatangani JWT token (ganti dengan string acak yang panjang)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

